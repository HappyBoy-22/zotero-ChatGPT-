{
  "manifest_version": 2,
  "name": "ChatGPT 论文助手",
  "version": "0.16.0",
  "description": "Zotero 阅读侧栏接入 ChatGPT 官网，支持论文独立对话、自动分析和 PDF 批注快捷键，无需 API Key。",
  "applications": {
    "zotero": {
      "id": "chatgpt-reader@local.zotero",
      "update_url": "https://example.invalid/chatgpt-reader/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
